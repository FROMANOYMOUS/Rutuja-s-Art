# =====================================================================
# RUTUJA'S ART COLLECTION - ENVIRONMENT SECRETS TEMPLATE
# Add these key-value pairs to your GitHub Repository Secrets:
# Settings -> Secrets and variables -> Actions -> Repository secrets
# =====================================================================

# GMAIL API OAUTH INTEGRATION (REQUIRED FOR ENCRYPTED GMAIL DISPATCH)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI="https://developers.google.com/oauthplayground"

# OPTIONAL: SERVICE ACCOUNT JSON (BASE64 OR RAW STRING)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# SUPABASE CLOUD & AUTHENTICATION SECRETS
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLOUD SQL / POSTGRESQL DATABASE CONNECTION
DATABASE_URL=
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# GOOGLE GEMINI AI API KEY
GEMINI_API_KEY=

# APP METADATA
APP_URL=

